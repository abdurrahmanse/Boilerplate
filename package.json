{
  "name": "/Boilerplate",
  "version": "6.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel//Boilerplate.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "bin": {
    "/Boilerplate": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma migrate dev",
    "migrate:deploy": "cd packages/database && bunx prisma generate && bunx prisma migrate deploy",
    "db:push": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma db push",
    "clean": "git clean -xdf node_modules",
    "release": "npm publish"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.5.12",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.10.12",
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "^15.0.0",
    "nypm": "^0.6.10"
  },
  "overrides": {
    "parse5": "^7.2.1"
  },
  "type": "module"
}
